# Maintainer: MediaConv Contributors
pkgname=mediaconv
pkgver=1.0.0
pkgrel=0
pkgdesc="Local media transcoder"
url="https://github.com/nost3a/MediaConv"
arch="x86_64"
license="MIT"
depends="ffmpeg mesa-gl"

package() {
    install -Dm755 "$SRCREPO/bin/mediaconv-linux-amd64" "$pkgdir/usr/bin/mediaconv"
    install -Dm755 "$SRCREPO/bin/mconv-linux-amd64" "$pkgdir/usr/bin/mconv"
    install -Dm755 "$SRCREPO/bin/MediaConv-Linux-amd64-cli" "$pkgdir/usr/bin/mediaconv-cli"
}
